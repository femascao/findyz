# ====== Base de Dados ======
# Preencha em .env.local com a sua URL do Neon/Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# ====== Admin simples (endpoints /admin/*) ======
# Defina um valor forte em .env.local e no Vercel (Project > Settings > Env Vars)
ADMIN_TOKEN="defina-um-segredo-aqui"

# ====== Emails (Resend) — opcional ======
# Necessário apenas se quiser receber notificação por email no /api/register-interest
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
RESEND_FROM="Findyz <no-reply@seu-dominio-verificado.com>"
RESEND_TO="geral@findyz.pt"

# ====== Clerk (login) — opcional se estiver usando Clerk ======
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxx"

# ====== Vercel Preview Protection (para testes via curl/bypass) — opcional ======
# Usado só localmente para scripts de teste; não é lido pela app
VERCEL_BYPASS_TOKEN=""

# ====== Node/Next — recomendado ======
# Trave a versão do Node local (combine com seu .nvmrc)
NODE_ENV="development"

